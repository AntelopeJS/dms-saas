{
  "name": "@antelopejs/interface-dms-saas",
  "version": "0.6.1",
  "description": "AntelopeJS interface for the DMS SaaS module: billing, plans, registration, workspace pages and lifecycle extension points.",
  "keywords": [
    "antelopejs",
    "billing",
    "dms",
    "interface",
    "saas"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/saas/extending",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-saas/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-saas.git",
    "directory": "packages/interface-dms-saas"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "docs",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/models": {
      "types": "./dist/db/models/index.d.ts",
      "default": "./dist/db/models/index.js"
    },
    "./db/tables": {
      "types": "./dist/db/tables/index.d.ts",
      "default": "./dist/db/tables/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "check:exports": "node scripts/check-exports.mjs",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "release": "pnpm run build && release-it",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@antelopejs/interface-data-api": "file:../../.campaign/tgz/antelopejs-interface-data-api-2b29c9d.tgz",
    "@antelopejs/interface-dms": ">=0.9.0 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-6bef278.tgz",
    "@antelopejs/interface-database-decorators": "file:../../.campaign/tgz/antelopejs-interface-database-decorators-fcb0a29.tgz",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.11 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.10 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {}
}
