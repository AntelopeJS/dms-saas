{
  "name": "@antelopejs/interface-dms-saas",
  "version": "0.0.2",
  "description": "Public interfaces for the DMS SaaS module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-saas.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/*": [
        "dist/*",
        "dist/*/index.d.ts"
      ],
      "*": [
        "dist/*",
        "dist/*/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/models": {
      "types": "./dist/db/models/index.d.ts",
      "default": "./dist/db/models/index.js"
    },
    "./db/tables": {
      "types": "./dist/db/tables/index.d.ts",
      "default": "./dist/db/tables/index.js"
    },
    "./dist": {
      "types": "./dist/index.d.ts"
    },
    "./dist/db": {
      "types": "./dist/db/index.d.ts"
    },
    "./dist/db/models": {
      "types": "./dist/db/models/index.d.ts"
    },
    "./dist/db/tables": {
      "types": "./dist/db/tables/index.d.ts"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt .",
    "format": "oxfmt .",
    "typecheck": "tsc -p tsconfig.json",
    "check:package-contract": "node scripts/check-package-contract.mjs",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "release": "pnpm run lint && pnpm run build && release-it",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@antelopejs/interface-data-api": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-dms": ">=0.0.1 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.7 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.7 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {}
}
