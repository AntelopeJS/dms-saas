{
  "git": {
    "commitMessage": "chore(release): @antelopejs/dms-saas v${version}",
    "tagName": "v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/dms-saas v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm --dir ../.. run lint",
      "pnpm --dir ../.. run format:check"
    ],
    "after:bump": ["git add CHANGELOG.md", "node scripts/publish.mjs"]
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  }
}
