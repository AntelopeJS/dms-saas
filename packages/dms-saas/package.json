{
  "name": "@antelopejs/dms-saas",
  "version": "0.8.1",
  "description": "SaaS module for the AntelopeJS DMS: self-service sign-up and pricing, plans that gate features, Stripe billing, workspace settings and a back office.",
  "keywords": [
    "antelopejs",
    "billing",
    "dms",
    "dms-module",
    "multi-tenant",
    "saas",
    "stripe"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/saas",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-saas/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-saas.git",
    "directory": "packages/dms-saas"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "skills",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @antelopejs/interface-dms-saas build && rimraf dist && tsc",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "ajs project run -w -p playground",
    "stripe:webhooks": "stripe listen --forward-to localhost:5010/api/saas/webhooks/stripe",
    "typecheck": "tsc --noEmit",
    "verify:interface": "node scripts/verify-interface-package.mjs",
    "test": "pnpm run build && pnpm --filter @antelopejs/interface-dms-saas run check:exports && pnpm run test:unit",
    "test:unit": "vitest run",
    "release": "pnpm --filter @antelopejs/interface-dms-saas build && pnpm --dir frontend-vue install --frozen-lockfile && pnpm run verify:interface && release-it",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": "file:../../.campaign/tgz/antelopejs-interface-api-2d1cc37.tgz",
    "@antelopejs/interface-api-util": "file:../../.campaign/tgz/antelopejs-interface-api-util-639f38b.tgz",
    "@antelopejs/interface-core": "file:../../.campaign/tgz/antelopejs-interface-core-6a8b526.tgz",
    "@antelopejs/interface-data-api": "file:../../.campaign/tgz/antelopejs-interface-data-api-7a8719d.tgz",
    "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
    "@antelopejs/interface-database-decorators": "file:../../.campaign/tgz/antelopejs-interface-database-decorators-1234214.tgz",
    "@antelopejs/interface-dms": "file:../../.campaign/tgz/antelopejs-interface-dms-c05ba50.tgz",
    "@antelopejs/interface-dms-saas": "workspace:^",
    "node-cron": "^4.2.1",
    "stripe": "^22.6.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@antelopejs/core": "file:../../.campaign/tgz/antelopejs-core-68d5ce0.tgz",
    "@antelopejs/dms": "file:../../.campaign/tgz/antelopejs-dms-c05ba50.tgz",
    "@antelopejs/dms-frontend": ">=0.9.1 <0.10.0",
    "@antelopejs/mongodb": "file:../../.campaign/tgz/antelopejs-mongodb-db4b449.tgz",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^11.0.1",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-automation": "file:../../.campaign/tgz/antelopejs-interface-dms-automation-b4bc5d2.tgz"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/interface-dms-saas"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
