{
  "name": "@antelopejs/dms-saas",
  "version": "0.1.8",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-saas.git"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @antelopejs/interface-dms-saas build && rimraf dist && tsc",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "ajs project run -w -p playground",
    "stripe:webhooks": "stripe listen --forward-to localhost:5010/api/saas/webhooks/stripe",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && cd frontend-vue && pnpm lint:fix",
    "lint": "oxlint && oxfmt --check . && cd frontend-vue && pnpm lint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt . && cd frontend-vue && pnpm format",
    "check:package-contract": "node scripts/check-package-contract.mjs",
    "verify:interface": "node scripts/verify-interface-package.cjs",
    "test": "pnpm run build && pnpm --filter @antelopejs/interface-dms-saas run check:package-contract && pnpm run check:package-contract && pnpm run test:unit",
    "test:unit": "vitest run",
    "release": "pnpm --filter @antelopejs/interface-dms-saas build && pnpm --dir frontend-vue install --frozen-lockfile && pnpm run verify:interface && release-it",
    "prepack": "pnpm run build && pnpm run check:package-contract",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.2 <1.0.0",
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.7 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0",
    "@antelopejs/interface-dms": ">=0.1.0 <1.0.0",
    "@antelopejs/interface-dms-saas": ">=0.0.2 <1.0.0",
    "@antelopejs/interface-file-storage": ">=0.1.3 <1.0.0",
    "node-cron": "^4.2.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@antelopejs/core": "1.8.0",
    "@antelopejs/dms": ">=0.3.5 <1.0.0",
    "@antelopejs/dms-frontend": "0.2.0",
    "@antelopejs/file-storage-local": "0.1.4",
    "@antelopejs/mongodb": "1.3.0",
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^11.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-automation": ">=0.0.1 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/interface-dms-saas"
    ]
  }
}
