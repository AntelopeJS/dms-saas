{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "paths": {
      "@antelopejs/interface-dms-saas/*": [
        "./packages/interface-dms-saas/src/*"
      ],
      "@antelopejs/interface-dms/*": [
        "./packages/dms-saas/node_modules/@antelopejs/interface-dms/dist/*"
      ],
      "*": ["./packages/dms-saas/node_modules/*"]
    }
  },
  "files": [
    "oxlint.config.ts",
    "packages/dms-saas/test/helpers/vue-runtime/index.mjs",
    ".amp/gateway.mjs",
    "packages/interface-dms-saas/scripts/check-exports.mjs",
    "packages/dms-saas/vitest.config.ts",
    "packages/dms-saas/playground/antelope.config.ts"
  ],
  "include": [
    ".agents/skills/**/*.mjs",
    ".agents/skills/verify-dms-saas/playground/src/**/*.ts"
  ]
}
