{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts"]
}
