{
  "name": "dms-saas-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @antelopejs/dms-saas build",
    "lint": "oxlint && antelopejs-check-interface-ranges && pnpm --dir packages/dms-saas/frontend-vue lint && node packages/dms-saas/scripts/checks/index.mts && node packages/dms-saas/node_modules/@antelopejs/dms/frontend-vue/scripts/check-api-error-presentation.mjs packages/dms-saas/frontend-vue/app",
    "typecheck": "pnpm run build",
    "test": "pnpm --filter @antelopejs/interface-dms-saas check:exports",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format": "oxfmt . && pnpm --dir packages/dms-saas/frontend-vue format",
    "format:check": "oxfmt --check .",
    "knip": "pnpm --filter @antelopejs/interface-dms-saas knip && pnpm --filter @antelopejs/dms-saas knip",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && pnpm --dir packages/dms-saas/frontend-vue lint:fix",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.5.1",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mongodb-memory-server": "^11.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.56.1",
    "sharp": "^0.35.5"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-data-api": "file:.tgz-deps/antelopejs-interface-data-api-d70049c.tgz",
      "@antelopejs/interface-dms": "file:.tgz-deps/antelopejs-interface-dms-0be8e9a.tgz",
      "@antelopejs/dms": "file:.tgz-deps/antelopejs-dms-0be8e9a.tgz",
      "@antelopejs/dms>@antelopejs/interface-api": "0.3.0",
      "@antelopejs/dms>@antelopejs/interface-api-util": "0.3.2",
      "@antelopejs/dms>@antelopejs/interface-core": "0.4.0",
      "@antelopejs/dms>@antelopejs/interface-database": "0.4.0",
      "@antelopejs/dms>@antelopejs/interface-database-decorators": "0.5.2",
      "@antelopejs/interface-dms-builder": "file:.tgz-deps/antelopejs-interface-dms-builder-0be8e9a.tgz"
    }
  },
  "antelopeJs": {
    "docs": {
      "standard": true
    }
  }
}
