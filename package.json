{
  "name": "dms-saas-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @antelopejs/dms-saas build",
    "lint": "oxlint && antelopejs-check-interface-ranges && pnpm --dir packages/dms-saas/frontend-vue lint && node packages/dms-saas/scripts/checks/index.mts && node packages/dms-saas/node_modules/@antelopejs/dms/frontend-vue/scripts/check-api-error-presentation.mjs packages/dms-saas/frontend-vue/app",
    "typecheck": "pnpm run build",
    "test": "pnpm --filter @antelopejs/interface-dms-saas check:exports",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format": "oxfmt . && pnpm --dir packages/dms-saas/frontend-vue format",
    "format:check": "oxfmt --check .",
    "knip": "pnpm --filter @antelopejs/interface-dms-saas knip && pnpm --filter @antelopejs/dms-saas knip",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && pnpm --dir packages/dms-saas/frontend-vue lint:fix",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "file:.campaign/tgz/antelopejs-tooling-configs-6b759e6.tgz",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
      "@antelopejs/mongodb": "file:.campaign/tgz/antelopejs-mongodb-db4b449.tgz",
      "@antelopejs/interface-database-decorators": "file:.campaign/tgz/antelopejs-interface-database-decorators-1234214.tgz",
      "@antelopejs/interface-data-api": "file:.campaign/tgz/antelopejs-interface-data-api-bca1ca6.tgz",
      "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-015a93a.tgz",
      "@antelopejs/interface-api-util": "file:.campaign/tgz/antelopejs-interface-api-util-639f38b.tgz",
      "@antelopejs/interface-dms": "file:.campaign/tgz/antelopejs-interface-dms-42d657b.tgz",
      "@antelopejs/dms": "file:.campaign/tgz/antelopejs-dms-42d657b.tgz",
      "@antelopejs/interface-dms-automation": "file:.campaign/tgz/antelopejs-interface-dms-automation-b4bc5d2.tgz",
      "@antelopejs/dms-frontend": "file:.campaign/tgz/antelopejs-dms-frontend-ee4e931.tgz",
      "@antelopejs/interface-core": "file:.campaign/tgz/antelopejs-interface-core-f7df541.tgz",
      "@antelopejs/core": "file:.campaign/tgz/antelopejs-core-184eb90.tgz",
      "@antelopejs/tooling-configs": "file:.campaign/tgz/antelopejs-tooling-configs-6b759e6.tgz"
    }
  },
  "antelopeJs": {
    "docs": {
      "standard": true
    }
  }
}
