{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 16,
    "anti-slop/no-known-value-widening": 7,
    "anti-slop/no-runtime-typeof": 2,
    "anti-slop/no-unknown-parameters": 73,
    "anti-slop/no-unknown-returns": 6,
    "anti-slop/no-unsafe-dictionary-type": 35,
